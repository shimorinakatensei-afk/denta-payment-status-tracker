# Copy this file to .env and set the local database user and password.
# Do not commit .env or put real credentials in this template.
POSTGRES_DB=denta_payments
POSTGRES_USER=
POSTGRES_PASSWORD=

# Set the same database name, username, and password for Spring Boot.
DB_URL=jdbc:postgresql://localhost:5432/denta_payments
DB_USERNAME=
DB_PASSWORD=

# Optional frontend API base URL (used when API integration is added)
VITE_API_BASE_URL=http://localhost:8080

# Firebase Admin credentials are intentionally not included.
# Configure Firebase locally when notification delivery is implemented.
